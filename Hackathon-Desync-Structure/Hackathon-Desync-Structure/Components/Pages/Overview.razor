@page "/overview"
@rendermode InteractiveServer
@using Hackathon_Desync_Structure.Core.Models
@using Hackathon_Desync_Structure.Core.Services
@using Hackathon_Desync_Structure.Core.Services.Interfaces
@inject IMockService _mockService
@inject CurrentUserService CurrentUser
@inject NavigationManager Nav


<div class="mb-3 w-25">
    <div>
        <h3>View all your assignments</h3>
    </div>

    <div>
        <label class="form-label">Filter op status</label>
        <select class="form-select" @bind="selectedFilter">
            <option value="Alles">Alles</option>
            <option value="Voltooid">Voltooid</option>
            <option value="Niet voltooid">Niet voltooid</option>
        </select>
    </div>
   
</div>

<div class="row mx-3">
    @foreach (PersonTask task in FilteredTasks)
    {
        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">@task.Task?.Title</h5>
                    <h6 class="card-subtitle mb-2 text-muted">@task.Task?.Subject?.Name</h6>
                    <p class="card-text">
                        Start: @task.Task?.StartDate.ToString("dd/MM/yyyy")<br />
                        Deadline: @task.Task?.DueDate.ToString("dd/MM/yyyy")<br />
                        <span class="text-danger">@GetDeadlineMessage(task)</span>
                    </p>
                    @if (!(task.Task.DueDate < DateTime.Today))
                    {
                        <span class="badge @GetBadgeClass(task)">@GetStatus(task)</span>
                        <div class="form-check mt-2 @IsCheckBoxEnabled(task)">
                            <input class="form-check-input"
                                   type="checkbox"
                                   @bind="task.Completed" />
                        </div>
                    }
                    
                    
                </div>
            </div>
        </div>
    }
</div>

@code {
    IEnumerable<PersonTask> personTasksModel = new List<PersonTask>();
    private string selectedFilter = "Alles";
    protected override async Task OnInitializedAsync()
    {
        personTasksModel = await _mockService.GetTasksFromPerson(CurrentUser.User!.Id);
    }

    

    private IEnumerable<PersonTask> FilteredTasks =>
        selectedFilter switch
        {
            "Voltooid" => personTasksModel.Where(t => t.Completed),
            "Niet voltooid" => personTasksModel.Where(t => !t.Completed),
            _ => personTasksModel
        };

    public string GetStatus(PersonTask task)
    {
        if (task.Completed) return "voltooid";
        else return "niet voltooid";
    }

    public string GetBadgeClass(PersonTask task)
    {
        if (task.Completed) return "bg-primary";
        else return "bg-danger";
    }

    public string GetDeadlineMessage(PersonTask task)
    {
        if (task.Task.DueDate < DateTime.Today) return "Deadline niet gehaald";
        else return "";
    }

    public string IsCheckBoxEnabled(PersonTask task)
    {
        if (task.Task.DueDate < DateTime.Today) return "disabled";
        else return "";
    }
}