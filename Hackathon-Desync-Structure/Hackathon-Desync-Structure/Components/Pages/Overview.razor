@page "/overview"
@rendermode InteractiveServer
@using Hackathon_Desync_Structure.Core.Models
@using Hackathon_Desync_Structure.Core.Services
@using Hackathon_Desync_Structure.Core.Services.Interfaces
@inject IMockService _mockService
@inject CurrentUserService CurrentUser
@inject NavigationManager Nav

<h3>View all your assignments</h3>

<div class="row mx-3">
    @foreach (PersonTask task in personTasksModel)
    {
        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">@task.Task?.Title</h5>
                    <h6 class="card-subtitle mb-2 text-muted">@task.Task?.Subject?.Name</h6>
                    <p class="card-text">
                        Start: @task.Task?.StartDate.ToString("dd/MM/yyyy")<br />
                        Deadline: @task.Task?.DueDate.ToString("dd/MM/yyyy")
                    </p>
                    <span class="badge @GetBadgeClass(task)">@GetStatus(task)</span>
                    <div class="form-check mt-2">
                        <input class="form-check-input" type="checkbox" id="chk-@task.TaskId"
                               @bind="task.Completed" />
                        <label class="form-check-label" for="chk-@task.TaskId">Voltooid</label>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    IEnumerable<PersonTask> personTasksModel = new List<PersonTask>();

    protected override async Task OnInitializedAsync()
    {
        if (!CurrentUser.IsLoggedIn)
        {
            Nav.NavigateTo("/login");
            return;
        }

        personTasksModel = await _mockService.GetTasksFromPerson(CurrentUser.User!.Id);
    }

    private string GetStatus(PersonTask task)
    {
        if (task.Completed) return "voltooid";
        if (task.Task!.DueDate < DateTime.Now) return "verstreken";
        return "onvoltooid";
    }

    private string GetBadgeClass(PersonTask task)
    {
        if (task.Completed) return "bg-success";
        if (task.Task!.DueDate < DateTime.Now) return "bg-danger";
        return "bg-warning text-dark";
    }
}